<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Food Product to SQLite DB"
        android:textColor="@color/dark_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etAddFoodName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="Food Name (e.g. Garlic Bread)"
        android:inputType="text"
        android:padding="12dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etAddFoodCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="Category (e.g. Pizza, Burger, Desserts, Beverages)"
        android:inputType="text"
        android:padding="12dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etAddFoodDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="Description"
        android:inputType="text"
        android:padding="12dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etAddFoodPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="Price (₹)"
        android:inputType="number"
        android:padding="12dp"
        android:textSize="14sp" />

</LinearLayout>
