<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/homeToolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/screen_background"
        android:elevation="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        app:contentInsetStart="0dp"
        app:contentInsetEnd="0dp"
        app:popupTheme="@style/HomePopupTheme"
        app:title=""
        app:titleTextColor="@color/dark_text">

        <LinearLayout
            android:id="@+id/toolbarBrand"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivToolbarFoodLogo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_food_badge"
                android:contentDescription="@string/p4_brand_icon_description"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_yummcart_food" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p4_app_title"
                    android:textColor="@color/primary_blue"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:letterSpacing="0.06"
                    android:text="@string/p4_brand_tagline"
                    android:textColor="@color/secondary_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:text="@string/p4_welcome_default"
        android:textColor="@color/dark_text"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHomeIntro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/p4_home_caption"
        android:textColor="@color/secondary_text"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/p4_nav_home_description"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/primary_blue" />
            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/p4_nav_home"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/navCategoriesIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/p4_nav_categories_description"
                android:src="@drawable/ic_nav_categories"
                android:tint="@color/secondary_text" />
            <TextView
                android:id="@+id/navCategoriesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/p4_nav_categories"
                android:textColor="@color/secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/navAccountIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/p4_nav_account_description"
                android:src="@drawable/ic_nav_account"
                android:tint="@color/secondary_text" />
            <TextView
                android:id="@+id/navAccountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/p4_nav_account"
                android:textColor="@color/secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/navCartIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/p4_nav_cart_description"
                android:src="@drawable/ic_nav_cart"
                android:tint="@color/secondary_text" />
            <TextView
                android:id="@+id/navCartLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/p4_nav_cart"
                android:textColor="@color/secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
