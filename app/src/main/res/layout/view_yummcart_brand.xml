<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/yummCartBrandRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_brand_header"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ivYummCartBrandIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_food_badge"
        android:contentDescription="@string/p4_brand_icon_description"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_yummcart_food" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p4_app_title"
            android:textColor="@color/primary_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:letterSpacing="0.06"
            android:text="@string/p4_brand_tagline"
            android:textColor="@color/secondary_text"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
