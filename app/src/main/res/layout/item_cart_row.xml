<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCartItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCartItemDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCartDecrease"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="−"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvCartQuantity"
        android:layout_width="28dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:textColor="@color/dark_text"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCartIncrease"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnCartRemove"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/p4_remove"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="12sp" />

</LinearLayout>
